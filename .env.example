# Public read-only WordPress endpoint. No credentials are needed.
# The existing host currently serves HTTP; repair its HTTPS before production.
WORDPRESS_API_URL=http://www.pratirodh.com/wp-json/wp/v2
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until domain, TLS, canonical URLs and CMS indexing are finalized.
ALLOW_INDEXING=false
# Optional, at least 32 random characters. Leave empty to disable the webhook.
REVALIDATE_SECRET=
